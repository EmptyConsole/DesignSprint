{
  "name": "sortly",
  "version": "1.0.0",
  "description": "Point your camera at an item, get local recycling/compost/trash guidance.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/dev.ts\" \"vite\"",
    "dev:phone": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/dev.ts\" \"vite --mode phone\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmptyConsole/DesignSprint.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/EmptyConsole/DesignSprint/issues"
  },
  "homepage": "https://github.com/EmptyConsole/DesignSprint#readme",
  "dependencies": {
    "lucide-react": "^1.52.0",
    "openai": "^7.28.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}
